{
  "buildCommand": "npm run build --prefix frontend && node -e \"import('fs').then(fs => fs.cpSync('frontend/dist', './dist', {recursive: true}))\"",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend-five-khaki-22.vercel.app/api/:path*"
    },
    {
      "source": "/api",
      "destination": "https://backend-five-khaki-22.vercel.app/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
